# ==============================================================================
# Loomi Interactive Quiz & Learning Platform — Environment Variables Template
# Copy this file to backend/.env when running the backend service.
# ==============================================================================

# Server & Security
LOOMI_SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
HOST=127.0.0.1

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./loomi.db

# Local Ollama AI Engine
# Download Ollama from https://ollama.com
# Pull required models:
#   ollama pull qwen3:8b
#   ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=llama3.2:3b

# Optional OAuth 2.0 Single Sign-On (SSO)
# Leave blank to use email/password authentication and guest PIN access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback/microsoft

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:5173/auth/callback/apple
