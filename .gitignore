# ==============================================================================
# Loomi Interactive Quiz & Learning Platform — Git Ignore Configuration
# ==============================================================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/
eggs/
.eggs/

# SQLite Database & State (Exclude local runtime databases & journals)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/loomi.db*

# Temporary & Uploaded Files
backend/uploads/*
!backend/uploads/.gitkeep
*.tmp
*.temp

# Node & Frontend Dependencies / Bundles
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Large AI/ML Model Weights (Pull models via Ollama CLI, do not track in Git)
*.gguf
*.bin
*.safetensors
*.onnx
models/

# Logs & Monitoring
*.log
logs/

# IDE & Editor Specific Files
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
